PORT_ROSBRIDGE=9090
PORT_CONTROL_PANEL=4004

# DDS discovery (scripts/dds_env.sh). macOS defaults to localhost-only unicast
# because multicast needs a Local Network permission tmux never gets.
# LUCY_DDS_LOCALHOST=0
# LUCY_DDS_INTERFACE=192.168.1.5
# LUCY_DDS_PEERS=hostA,hostB

# Firmware toolchain (install.py runs `pixi run firmware-setup` after the build).
# Set to skip rustup/elf2uf2 install during CI or sim-only machines:
# LUCY_SKIP_FIRMWARE_SETUP=1
# Skip interactive udev install during firmware-setup (non-TTY already skips):
# LUCY_FIRMWARE_SETUP_SKIP_UDEV=1
# Force udev install in non-interactive shells:
# LUCY_FIRMWARE_SETUP_INSTALL_UDEV=1
