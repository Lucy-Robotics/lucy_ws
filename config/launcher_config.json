{
  "packages": [
    {
      "id": "core",
      "name": "Core",
      "description": "Base robot software stack",
      "type": "core",
      "dependencies": [],
      "conflicts": [],
      "command": "ros2 launch lucy_bringup lucy.launch.py",
      "readiness_stages": [
        {
          "label": "Activating environment",
          "check": "bash scripts/instance_pgrep.sh -f 'bin/[r]os2 launch lucy_bringup' >/dev/null 2>&1"
        },
        {
          "label": "Starting Rosbridge",
          "check": "bash scripts/instance_pgrep.sh -f '[r]osbridge_websocket' >/dev/null 2>&1"
        },
        {
          "label": "Opening Rosbridge port",
          "check": "bash scripts/port_open.sh ${PORT_ROSBRIDGE:-9090}"
        },
        {
          "label": "Starting config services",
          "check": "bash scripts/instance_pgrep.sh -f '[c]onfig_pipeline_node' >/dev/null 2>&1"
        },
        {
          "label": "Starting control supervisor",
          "check": "bash scripts/instance_pgrep.sh -f '[c]ontrol_supervisor_node' >/dev/null 2>&1"
        },
        {
          "label": "Building robot model",
          "check": "bash scripts/instance_pgrep.sh -f '[r]obot_state_publisher' >/dev/null 2>&1"
        },
        {
          "label": "Starting controller manager",
          "check": "bash scripts/controllers_active.sh 0"
        },
        {
          "label": "Activating controllers",
          "check": "bash scripts/controllers_active.sh 1"
        }
      ],
      "readiness_timeout": 150,
      "default_on": false
    },
    {
      "id": "robot_inmoov",
      "requires_component": "robot_inmoov",
      "name": "InMoov",
      "description": "(robot_package:=inmoov_urdf)",
      "type": "modifier",
      "dependencies": ["core"],
      "conflicts": ["robot_thais", "robot_so_arm101", "robot_inmoov_i2", "robot_marty", "robot_unitree_g1", "robot_unitree_r1"],
      "command": "robot_package:=inmoov_urdf",
      "requires_pkg": "inmoov_urdf",
      "default_on": true
    },
    {
      "id": "robot_so_arm101",
      "requires_component": "robot_so_arm101",
      "name": "SO-ARM101",
      "description": "(robot_package:=so_arm101_urdf)",
      "type": "modifier",
      "dependencies": ["core"],
      "conflicts": ["robot_inmoov", "robot_thais", "robot_inmoov_i2", "robot_marty", "robot_unitree_g1", "robot_unitree_r1"],
      "command": "robot_package:=so_arm101_urdf",
      "requires_pkg": "so_arm101_urdf",
      "default_on": false
    },
    {
      "id": "robot_inmoov_i2",
      "requires_component": "robot_inmoov_i2",
      "name": "InMoov i2",
      "description": "(robot_package:=inmoov_i2_urdf)",
      "type": "modifier",
      "dependencies": ["core"],
      "conflicts": ["robot_inmoov", "robot_thais", "robot_so_arm101", "robot_marty", "robot_unitree_g1", "robot_unitree_r1"],
      "command": "robot_package:=inmoov_i2_urdf",
      "requires_pkg": "inmoov_i2_urdf",
      "default_on": false
    },
    {
      "id": "robot_marty",
      "requires_component": "robot_marty",
      "name": "Marty",
      "description": "(robot_package:=marty_urdf)",
      "type": "modifier",
      "dependencies": ["core"],
      "conflicts": ["robot_inmoov", "robot_thais", "robot_so_arm101", "robot_inmoov_i2", "robot_unitree_g1", "robot_unitree_r1"],
      "command": "robot_package:=marty_urdf",
      "requires_pkg": "marty_urdf",
      "default_on": false
    },
    {
      "id": "robot_unitree_g1",
      "requires_component": "robot_unitree_g1",
      "name": "Unitree G1",
      "description": "(robot_package:=unitree_g1_urdf)",
      "type": "modifier",
      "dependencies": ["core"],
      "conflicts": ["robot_inmoov", "robot_thais", "robot_so_arm101", "robot_inmoov_i2", "robot_marty", "robot_unitree_r1"],
      "command": "robot_package:=unitree_g1_urdf",
      "requires_pkg": "unitree_g1_urdf",
      "default_on": false
    },
    {
      "id": "robot_unitree_r1",
      "requires_component": "robot_unitree_r1",
      "name": "Unitree R1",
      "description": "(robot_package:=unitree_r1_urdf)",
      "type": "modifier",
      "dependencies": ["core"],
      "conflicts": ["robot_inmoov", "robot_thais", "robot_so_arm101", "robot_inmoov_i2", "robot_marty", "robot_unitree_g1"],
      "command": "robot_package:=unitree_r1_urdf",
      "requires_pkg": "unitree_r1_urdf",
      "default_on": false
    },
    {
      "id": "simulator",
      "name": "Simulator",
      "description": "(mock hardware: mode:=mock)",
      "type": "modifier",
      "dependencies": ["core"],
      "conflicts": [],
      "choice": "launch mode",
      "command": "mode:=mock",
      "default_on": false
    },
    {
      "id": "gazebo",
      "requires_component": "simulation",
      "name": "Physics Simulator (Gazebo)",
      "description": "(mode:=sim)",
      "type": "modifier",
      "dependencies": ["core"],
      "conflicts": [],
      "choice": "launch mode",
      "command": "mode:=sim",
      "readiness_check": "bash scripts/instance_pgrep.sh -f '[g]z sim' >/dev/null 2>&1",
      "readiness_timeout": 120,
      "default_on": false
    },
    {
      "id": "headless",
      "requires_component": "simulation",
      "name": "Headless",
      "description": "(server-only, no GUI)",
      "type": "modifier",
      "dependencies": ["gazebo"],
      "conflicts": [],
      "command": "headless:=true",
      "subitem": true,
      "default_on": false
    },
    {
      "id": "hardware",
      "requires_component": "firmware",
      "name": "Hardware",
      "description": "(physical robot, through the bridge its package names: mode:=real)",
      "type": "modifier",
      "dependencies": ["core"],
      "conflicts": [],
      "choice": "launch mode",
      "command": "mode:=real",
      "crash_log_window": "core",
      "readiness_check": "bash scripts/instance_pgrep.sh -f '[l]ucy-embedded-firmware-(linux|mcu-bridge)' >/dev/null 2>&1",
      "readiness_timeout": 30,
      "default_on": false
    },
    {
      "id": "control_panel",
      "requires_component": "control_panel",
      "name": "Control Panel",
      "description": "Web-based UI",
      "url": "${LUCY_LCP_SCHEME}://localhost:${LUCY_LCP_PUBLISHED_HOST_PORT}",
      "type": "interface",
      "dependencies": [],
      "conflicts": [],
      "command": "pixi run panel-prod --port ${LUCY_LCP_PUBLISHED_HOST_PORT:-4004} --strictPort",
      "dev_command": "pixi run panel-dev --port ${LUCY_LCP_PUBLISHED_HOST_PORT:-4004} --strictPort",
      "command_win": "pixi run panel-prod --port 4004 --strictPort",
      "readiness_check": "bash scripts/port_open.sh ${LUCY_LCP_PUBLISHED_HOST_PORT:-4004}",
      "readiness_timeout": 300,
      "default_on": false
    },
    {
      "id": "panel_host_local",
      "requires_component": "control_panel",
      "name": "This computer only",
      "description": "Only this computer can open the panel",
      "type": "option",
      "parent": "control_panel",
      "conflicts": ["panel_host_network"],
      "command": "--host 127.0.0.1",
      "default_on": false
    },
    {
      "id": "panel_host_network",
      "requires_component": "control_panel",
      "name": "Every network (0.0.0.0)",
      "description": "Devices on your networks can open the panel",
      "type": "option",
      "parent": "control_panel",
      "conflicts": ["panel_host_local"],
      "command": "--host 0.0.0.0",
      "default_on": true
    },
    {
      "id": "lucy_cli",
      "name": "Lucy CLI",
      "description": "Command Line Interface",
      "type": "interface",
      "dependencies": ["core"],
      "conflicts": [],
      "command": "ros2 run lucy_cli tui",
      "readiness_check": "test -f ${LUCY_CLI_READY_FILE:-/tmp/lucy_cli.ready}",
      "nav_hint": "Ctrl-B W",
      "default_on": false
    },
    {
      "id": "rviz",
      "requires_component": "visualisation",
      "name": "Visualizer (RViz)",
      "description": "(use Control Panel 3D if OpenGL fails)",
      "type": "modifier",
      "dependencies": ["core"],
      "conflicts": [],
      "section": "tools",
      "command": "rviz:=true",
      "readiness_check": "bash scripts/instance_pgrep.sh -x rviz2 >/dev/null 2>&1",
      "readiness_timeout": 60,
      "default_on": false
    },
    {
      "id": "console",
      "name": "Open Console",
      "description": "Opens a new interactive terminal window",
      "type": "tool",
      "dependencies": [],
      "conflicts": [],
      "command": "echo \"To navigate, press Ctrl+B then W\" && bash -i",
      "default_on": false
    },
    {
      "id": "rqt",
      "requires_component": "visualisation",
      "name": "rqt GUI",
      "description": "Main ROS 2 GUI tool",
      "type": "tool",
      "dependencies": ["core"],
      "conflicts": [],
      "command": "rqt",
      "default_on": false
    }
  ]
}
