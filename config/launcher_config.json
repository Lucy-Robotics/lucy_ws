{
  "packages": [
    {
      "id": "core",
      "name": "Core",
      "description": "Base robot software stack",
      "type": "core",
      "dependencies": [],
      "conflicts": [],
      "command": "ros2 launch lucy_bringup lucy.launch.py",
      "readiness_stages": [
        {
          "label": "Activating environment",
          "check": "pgrep -f 'bin/[r]os2 launch lucy_bringup' >/dev/null 2>&1"
        },
        {
          "label": "Starting Rosbridge",
          "check": "pgrep -f '[r]osbridge_websocket' >/dev/null 2>&1"
        },
        {
          "label": "Opening Rosbridge port",
          "check": "bash scripts/port_open.sh ${PORT_ROSBRIDGE:-9090}"
        },
        {
          "label": "Starting config services",
          "check": "pgrep -f '[c]onfig_pipeline_node' >/dev/null 2>&1"
        },
        {
          "label": "Starting control supervisor",
          "check": "pgrep -f '[c]ontrol_supervisor_node' >/dev/null 2>&1"
        },
        {
          "label": "Building robot model",
          "check": "pgrep -f '[r]obot_state_publisher' >/dev/null 2>&1"
        },
        {
          "label": "Starting controller manager",
          "check": "bash scripts/controllers_active.sh 0"
        },
        {
          "label": "Activating controllers",
          "check": "bash scripts/controllers_active.sh 1"
        }
      ],
      "readiness_timeout": 150,
      "default_on": false
    },
    {
      "id": "robot_inmoov",
      "name": "Robot: InMoov",
      "description": "(robot_package:=inmoov_urdf)",
      "type": "modifier",
      "dependencies": ["core"],
      "conflicts": ["robot_thais", "robot_so_arm101"],
      "command": "robot_package:=inmoov_urdf",
      "requires_pkg": "inmoov_urdf",
      "default_on": true
    },
    {
      "id": "robot_so_arm101",
      "name": "Robot: SO-ARM101",
      "description": "(robot_package:=so_arm101_urdf)",
      "type": "modifier",
      "dependencies": ["core"],
      "conflicts": ["robot_inmoov", "robot_thais"],
      "command": "robot_package:=so_arm101_urdf",
      "requires_pkg": "so_arm101_urdf",
      "default_on": false
    },
    {
      "id": "gazebo",
      "name": "... with Simulator",
      "description": "(Gazebo)",
      "type": "modifier",
      "dependencies": ["core"],
      "conflicts": ["real"],
      "command": "gazebo:=true",
      "readiness_check": "pgrep -f '[g]z sim' >/dev/null 2>&1",
      "readiness_timeout": 120,
      "default_on": false
    },
    {
      "id": "headless",
      "name": "... headless",
      "description": "(server-only, no GUI)",
      "type": "modifier",
      "dependencies": ["gazebo"],
      "conflicts": [],
      "command": "headless:=true",
      "subitem": true,
      "default_on": false
    },
    {
      "id": "rviz",
      "name": "... with Visualizer",
      "description": "(RViz — use Control Panel 3D if OpenGL fails)",
      "type": "modifier",
      "dependencies": ["core"],
      "conflicts": [],
      "command": "rviz:=true",
      "readiness_check": "pgrep -x rviz2 >/dev/null 2>&1",
      "readiness_timeout": 60,
      "default_on": false
    },
    {
      "id": "real",
      "name": "... with Real Hardware",
      "description": "(Connect to physical robot)",
      "type": "modifier",
      "dependencies": ["core"],
      "conflicts": ["gazebo"],
      "command": "real:=true",
      "preflight_check": "pixi run firmware-check",
      "readiness_check": "test -f /tmp/.lucy_real_hardware_ready && pgrep -f '[l]ucy_embedded_firmware_sim' >/dev/null 2>&1",
      "exit_check": "cat /tmp/.lucy_real_hardware_status 2>/dev/null",
      "readiness_timeout": 30,
      "default_on": false
    },
    {
      "id": "control_panel",
      "name": "Control Panel",
      "description": "Web-based UI",
      "url": "${LUCY_LCP_SCHEME}://localhost:${LUCY_LCP_PUBLISHED_HOST_PORT}",
      "type": "interface",
      "dependencies": [],
      "conflicts": [],
      "command": "pixi run panel-dev",
      "readiness_check": "bash scripts/port_open.sh ${LUCY_LCP_PUBLISHED_HOST_PORT:-4004}",
      "readiness_timeout": 120,
      "default_on": false
    },
    {
      "id": "lucy_cli",
      "name": "Lucy CLI",
      "description": "Command Line Interface",
      "type": "interface",
      "dependencies": ["core"],
      "conflicts": [],
      "command": "ros2 run lucy_cli tui",
      "readiness_check": "test -f /tmp/lucy_cli.ready",
      "nav_hint": "Ctrl-B W",
      "default_on": false
    },
    {
      "id": "console",
      "name": "Open Console",
      "description": "Opens a new interactive terminal window",
      "type": "tool",
      "dependencies": [],
      "conflicts": [],
      "command": "echo \"To navigate, press Ctrl+B then W\" && bash -i",
      "default_on": false
    },
    {
      "id": "rqt",
      "name": "rqt GUI",
      "description": "Main ROS 2 GUI tool",
      "type": "tool",
      "dependencies": ["core"],
      "conflicts": [],
      "command": "rqt",
      "default_on": false
    }
  ]
}
