# Lucy USB serial access without dialout membership (MODE 0666 + uaccess).
# Installed by scripts/setup_udev.sh and pixi run firmware-setup.
#
# Raspberry Pi Pico CDC — firmwares/rp2040 + mcu_bridge (VID 2e8a / PID 0003)
SUBSYSTEM=="tty", ATTRS{idVendor}=="2e8a", ATTRS{idProduct}=="0003", MODE="0666", TAG+="uaccess"
# Feetech / Waveshare USB Single Serial (CH343) — firmwares/linux so101 (VID 1a86 / PID 55d3)
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d3", MODE="0666", TAG+="uaccess"
